{
  "name": "hm-symbol-website",
  "version": "0.0.1",
  "description": "用于便捷查找鸿蒙 HM Symbol 中的图标",
  "type": "module",
  "scripts": {
    "extract": "tsx scripts/extract-symbols.ts",
    "predev": "tsx scripts/extract-symbols.ts",
